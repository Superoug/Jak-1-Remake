       (< (- (-> *display* base-frame-counter) *remake-intro-frame*) (seconds 0.1))))
(define *remake-sun-relight* 0.75)
;; (lens flares légers)
(define *remake-lens-flare* 1.0)
;; RENDU REMAKE
(define *remake-grade-sharp* 0.35)
(define *remake-grade-vignette* 0.5)
(define *remake-grade-tint* 1.0)
