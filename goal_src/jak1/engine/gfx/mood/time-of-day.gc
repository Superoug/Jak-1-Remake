;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/sprite/sparticle/sparticle.gc")
(require "engine/gfx/mood/mood.gc")

;; DECOMP BEGINS

(defmethod asize-of ((this time-of-day-palette))
  "Compute the size in memory of a time-of-day-palette"
  (the-as int (+ (-> this type size) (* (* (-> this height) (-> this width)) 4))))

;; The time-of-day-effect function is a callback used before doing a time-of-day-update.
;; I think it's unused?
(define-extern time-of-day-effect (function none))

;; if undefined, set to nothing so we can still call it.
(if (zero? time-of-day-effect) (set! time-of-day-effect nothing))

(defbehavior time-of-day-update time-of-day-proc ()
  "Update the particles and sky tng renderer for time-of-day effects"
  (time-of-day-effect)
  ;; spawn or kill stars, if needed.
  (cond
    ;; should have stars in the sky
    ((and (or (>= (-> self hour) 19) (>= 5 (-> self hour)))
          (and (< 45.0 (-> *time-of-day-context* num-stars)) (-> *time-of-day-context* sky))) ;; sky + stars desired
     ;; see if we need more
     (when (and *dproc* (< (-> self star-count) (the int (-> *time-of-day-context* num-stars))))
       (spawn (-> self stars) (math-camera-pos))
       (+! (-> self star-count) 1)))
    ;; have stars, but don't want them
    ((> (-> self star-count) 0)
     ;; kill all stars.
     (forall-particles-with-key (-> self stars)
                                (lambda ((arg0 sparticle-system) (arg1 sparticle-cpuinfo))
                                  (if (< (the-as uint #x493e0) (-> arg1 next-time)) (set! (-> arg1 next-time) (the-as uint 5)) (sparticle-kill-it arg0 arg1))
                                  (none))
                                #t
                                #t)
     (set! (-> self star-count) 0)
     0))
  ;; spawn or kill sun, if needed
  (cond
    ((and (>= (-> self time-of-day) 6.25) (< (-> self time-of-day) 18.75) (!= (-> *time-of-day-context* sun-fade) 0.0))
     (when (and *dproc* (zero? (-> self sun-count)))
       (spawn (-> self sun) (math-camera-pos))
       (+! (-> self sun-count) 1)))
    ((> (-> self sun-count) 0) (kill-and-free-particles (-> self sun)) (set! (-> self sun-count) 0) 0))
  ;; spawn or kill green sun, if needed
  (cond
    ((and (or (>= (-> self time-of-day) 21.75) (>= 10.25 (-> self time-of-day)))
          (!= (-> *time-of-day-context* sun-fade) 0.0))
     (when (and *dproc* (zero? (-> self green-sun-count)))
       (spawn (-> self green-sun) (math-camera-pos))
       (+! (-> self green-sun-count) 1)))
    ((> (-> self green-sun-count) 0) (kill-and-free-particles (-> self green-sun)) (set! (-> self green-sun-count) 0) 0))
  ;; update the sky renderer.
  (update-sky-tng-data (-> self time-of-day))
  0
  (none))

;; State for just ticking time forward.
(defstate time-of-day-tick (time-of-day-proc)
  :code
    (behavior ()
      (loop
        (+! (-> self frame) (the int (* (-> self time-ratio) (-> *display* time-adjust-ratio))))
        ;; now update time...
        (when (>= (-> self frame) 300)
          ;; 300 ticks/second
          (while (>= (-> self frame) 300)
            (+! (-> self frame) -300)
            (+! (-> self second) 1))
          ;; 60 sec/minute
          (when (>= (-> self second) 60)
            (while (>= (-> self second) 60)
              (+! (-> self second) -60)
              (+! (-> self minute) 1))
            ;; 60 min/hour
            (when (>= (-> self minute) 60)
              (while (>= (-> self minute) 60)
                (+! (-> self minute) -60)
                (+! (-> self hour) 1))
              ;; 24 hour/day
              (when (>= (-> self hour) 24)
                (while (>= (-> self hour) 24)
                  (+! (-> self hour) -24)
                  (+! (-> self day) 1))
                ;; 7 day/week
                (when (>= (-> self day) 7)
                  (while (>= (-> self day) 7)
                    (+! (-> self day) -7)
                    (+! (-> self week) 1))
                  ;; 4 week/month
                  (when (>= (-> self week) 4)
                    (while (>= (-> self week) 4)
                      (+! (-> self week) -4)
                      (+! (-> self month) 1))
                    ;; 12 month/year
                    (when (>= (-> self month) 12)
                      (while (>= (-> self month) 12)
                        (+! (-> self month) -12)
                        (+! (-> self year) 1)))))))))
        ;; set the time of day float. This is in hours (0-24)
        (let* ((f0-4 (the float (-> self frame)))
               (f0-6 (+ (/ f0-4 300) (the float (-> self second))))
               (f0-8 (+ (/ f0-6 60) (the float (-> self minute))))
               (f0-10 (+ (/ f0-8 60) (the float (-> self hour)))))
          (set! (-> self time-of-day) f0-10)
          (set! (-> *time-of-day-context* time) f0-10))
        (suspend)))
  :post time-of-day-update)

(defbehavior init-time-of-day time-of-day-proc ()
  "Initialize the time-of-day process"
  (stack-size-set! (-> self main-thread) 128)
  (set! (-> self year) 0)
  (set! (-> self month) 0)
  (set! (-> self week) 0)
  (set! (-> self day) 0)
  (set! (-> self hour) 0)
  (set! (-> self minute) 0)
  (set! (-> self second) 0)
  (set! (-> self frame) 0)
  (set! (-> self time-of-day) 0.0)
  (if *time-of-day-fast* (set! (-> self time-ratio) 18000.0) (set! (-> self time-ratio) 300.0))
  (set! (-> self star-count) 0)
  (set! (-> self stars) (create-launch-control group-stars self))
  (set! (-> self sun) (create-launch-control group-sun self))
  (set! (-> self green-sun) (create-launch-control group-green-sun self))
  (go time-of-day-tick)
  (none))

(defun start-time-of-day ()
  "Start up the time of day process. Kill any existing ones"
  (kill-by-name 'time-of-day-proc *active-pool*)
  (set! *time-of-day-proc* (process-spawn time-of-day-proc :init init-time-of-day))
  (none))

(defun time-of-day-setup ((arg0 symbol))
  "This function is weird. Returns if time of day will tick forward or not.
  If you set arg0 it will toggle on/off time of day.
  Otherwise, calling the function has no side effects."
  (when arg0
    (cond
      ((= (-> *time-of-day-proc* 0 time-ratio) 0.0)
       (if *time-of-day-fast* (set! (-> *time-of-day-proc* 0 time-ratio) 18000.0) (set! (-> *time-of-day-proc* 0 time-ratio) 300.0))
       (set! *time-of-day-mode* 8))
      (else
       (set! (-> *time-of-day-proc* 0 time-ratio) 0.0)
       (set! *time-of-day-mode* 4)
       (set! (-> *time-of-day-proc* 0 hour) 12)
       (set! (-> *time-of-day-proc* 0 minute) 0)
       0)))
  (if (= (-> *time-of-day-proc* 0 time-ratio) 0.0) #f #t))

(defun set-time-of-day ((arg0 float))
  "Manually set the time of day."
  (let ((v1-0 *time-of-day-proc*))
    (set! (-> v1-0 0 hour) (the int arg0))
    (let ((a0-1 (* 60.0 (- arg0 (the float (the int arg0))))))
      (set! (-> v1-0 0 minute) (the int a0-1))
      (set! (-> v1-0 0 second) (the int (* 60.0 (- a0-1 (the float (the int a0-1))))))))
  0
  (none))

;; TODO time-of-day-interp-colors
;; TODO time-of-day-interp-colors-scratch

; (defun time-of-day-interp-colors-scratch ((data (pointer rgba)) (pal time-of-day-palette) (ctxt mood-context))
;   ;; TODO
;   (none)
;   )

(def-mips2c time-of-day-interp-colors-scratch (function (pointer rgba) time-of-day-palette mood-context none))

(defun init-time-of-day-context ((arg0 time-of-day-context))
  "Set up the title-light-group."
  (set-vector! (-> arg0 title-light-group dir0 color) 0.82 0.82 0.82 1.0)
  (set-vector! (-> arg0 title-light-group dir1 color) 2.0 2.0 2.0 1.0)
  (set-vector! (-> arg0 title-light-group ambi color) 0.5 0.5 0.5 1.0)
  (set! (-> arg0 title-light-group dir0 levels x) 1.0)
  (set! (-> arg0 title-light-group dir1 levels x) 1.0)
  (set! (-> arg0 title-light-group ambi levels x) 1.0)
  (none))

;; PC-REMAKE : éclairage. Accentue la lumière directionnelle (relief) et creuse
;; très légèrement l'ambiance sur les acteurs. Les groupes de lumière sont
;; reconstruits depuis les tables de mood À CHAQUE frame, donc appliquer un
;; multiplicateur en fin d'update-time-of-day est idempotent par construction.
;; Réglables en direct au REPL : (set! *remake-sun-boost* 1.4) etc.
;; Valeurs calibrées au REPL le 2026-08-12 (les premières,
;; plus fortes, rendaient l'herbe fluo : trop saturé).
(define *remake-sun-boost* 1.12)
;; 21/09 : #t = la direction du soleil (ombres + relumière + disque du post) suit
;; le soleil VISIBLE du ciel (orbite du niveau, = tables des artistes) ; #f = angle
;; synthétique selon l'heure (ancien comportement du remake, gardé en repli).
;; Activé le 21/09.
(define *remake-sun-from-mood* #t)
(define *remake-ambi-mult* 0.95)
;; PC-REMAKE : post-effets écran, direction artistique "Spyro Reignited" —
;; bloom doré + image plus saturée et chaude. Neutre si tout est à 0.
;; Réglables au REPL : (set! *remake-bloom* 1.2) etc.
;; Direction artistique (2026-08-13) : jeu LUMINEUX et COLORÉ, textures
;; chaleureuses — dorées et vives sans retomber dans le fluo refusé.
(define *remake-bloom* 0.55)
(define *remake-bloom-thresh* 0.0)
(define *remake-saturation* 0.1)
(define *remake-warmth* 0.2)
;; PC-REMAKE : ombres du soleil. La direction suit l'heure du jeu (est → ouest,
;; élévation maximale à midi). Force 0.45 = ombres douces lisibles.
(define *remake-shadow-strength* 0.6)
;; PC-REMAKE : cel-shading RETIRÉ (2026-08-13) —
;; le système reste en place à zéro, réactivable au REPL si besoin.
(define *remake-toon-poster* 0.0)
(define *remake-toon-edge* 0.0)
(define *remake-toon-levels* 6.0)
;; PC-REMAKE : passe image finale — mesurée, sans excès :
;; occlusion de contact douce, brume de distance légère, couleur filmique.
(define *remake-ssao* 0.55)
;; PC-REMAKE 18/08 : 0.14 → 0.0 — la double-brume délavait l'horizon en gris
;; par-dessus le fog d'origine (textures grises sans couleur ; perfectible)
(define *remake-depth-fog* 0.0)
(define *remake-dof* 0.0)
(define *remake-tonemap* 0.5)

;; PC-REMAKE : SYSTÈME DE LUMIÈRE REFAIT.
;; rayons de soleil / ré-éclairage directionnel / ambiance hémisphérique / spéculaire
(define *remake-godrays* 0.7)
;; PC-REMAKE : nuit. *remake-night-max* = à quel point la nuit est sombre
;; (1.0 = nuit complète), *remake-lamp-reach* multiplie le rayon des lampes,
;; *remake-lamp-bright* leur intensité. Mettre *remake-night-force* à une valeur
;; >= 0 fige la nuit pour tester au REPL (0 = plein jour, 1 = nuit noire).
(define *remake-night-max* 0.82) ;; 18/08 : nuit trop noire — éclaircie
;; 21/09 (tournée de nuit : marais 6/255, jungle 11, misty 13, entraînement 13 de
;; luminance moyenne à 21 h = injouable) : le plafond du 18/08 avait été perdu dans
;; la réécriture du 19/08 (nuit 1.0 partout) — il est ré-appliqué, et les niveaux
;; SANS lampes (rien pour lire la scène) ont un plafond plus bas encore.
(define *remake-night-max-nolamp* 0.70)
(define *remake-nolamp-levels* '(jungle misty swamp rolling training snow))
;; PC-REMAKE : les réglages que le joueur peut bouger depuis le menu du jeu
;; (Options → Graphismes → Éclairage remake). Stockés en POURCENT parce que
;; c'est ce qu'un curseur de menu manipule bien ; divisés par 100 à l'usage.
(deftype remake-gfx (structure)
  ((night      float)
   (lamp-power float)
   (lamp-range float)
   (sun        float)
   (occlusion  float)
   (shadows    float)
   (godrays    float)
   (bloom      float)
   ;; 21/09 : #t = direction du soleil visible du ciel (= tables des artistes)
   (sun-visible symbol)
   ;; 21/09 : détail intrinsèque des sols (grain + accentuation, tfrag3.frag), en %
   (detail     float)
   ;; 12/10 : dose de l'étalonnage rendu remake, en %
   (grade      float)))

(define *remake-gfx*
  (new 'static 'remake-gfx
       :sun-visible #t
       :detail 140.0
       :grade 100.0
       :night 100.0
       :lamp-power 200.0
       :lamp-range 260.0
       :sun 75.0
       :occlusion 55.0
       :shadows 60.0
       :godrays 70.0
       :bloom 55.0))
(define *remake-lamp-reach* 1.8)
(define *remake-lamp-bright* 1.3)
(define *remake-night-force* -1.0)
;; >0 : pose une lampe témoin sur Jak, pour vérifier la reconstruction monde
(define *remake-lamp-debug* 0.0)
(define *remake-lamp-debug-kind* 0)
;; valeur courante (0..1), lue par les lampes pour ne s'allumer qu'au crépuscule
(define *remake-night-now* 0.0)
;; 20/10 : rayons de soleil volumetriques a travers le feuillage (post_processing.frag) —
;; dose generale (0 = coupes) ; actifs dans la jungle, de jour.
(define *remake-shafts* 1.0)
;; 20/10 : dose (0..1) de l'herbe couchee autour de Jak pendant les cinematiques
(define *remake-grass-clear* 0.0)
;; 17/10 INTRO NAUGHTY DOG : le logo est un modèle 3D posé au ras de la caméra.
;; L'occlusion de contact (teintée bleu) y dessinait des ombres bleues et des
;; lettres fantômes, le bloom un halo blanc. Pendant l'intro (état ndi du logo,
;; title-obs.gc, qui date ce compteur à chaque image), le post repasse au
;; neutre : image identique au jeu d'origine.
(define *remake-intro-frame* (the-as time-frame 0))
(defun remake-intro-active? ()
  (and (nonzero? *remake-intro-frame*)
       (< (- (-> *display* base-frame-counter) *remake-intro-frame*) (seconds 0.1))))
(define *remake-sun-relight* 0.75)
;; 22/09 (lens flares légers) : gain des reflets
;; d'objectif du soleil (post_processing.frag) — 0 = aucun, 1 = léger
(define *remake-lens-flare* 1.0)
;; 12/10 RENDU REMAKE : étalonnage final.
;; dose (0 = image d'avant), netteté, vignette, teinte ; puis exposition,
;; contraste, saturation. Réglés par mesure contre les rendus de référence.
(define *remake-grade-sharp* 0.35)
(define *remake-grade-vignette* 0.5)
(define *remake-grade-tint* 1.0)
(define *remake-grade-exposure* 0.97)  ;; 12/10 v3 : 0.92 -> 0.97 (plage terne)
(define *remake-grade-contrast* 1.25)
(define *remake-grade-saturation* 1.0)
(define *remake-hemi-ambient* 0.4)
(define *remake-light-spec* 0.35)
;; (le compteur de résidence de la plage vit dans main.gc — l'ordre de
;; compilation exige que le hook connaisse le système de niveaux)

;; PC-REMAKE 21/09 : NIVEAUX INTÉRIEURS — pas de soleil ni de nuit là-dedans.
;; Jusqu'ici l'horloge y jouait quand même : de jour les luminaires du décor
;; (tubes chauds de la cité engloutie, lueurs précurseur, cristaux) n'éclairaient
;; qu'à 30 %, et de nuit un clair de lune bleu assombrissait des grottes qui
;; n'ont pas de ciel. Liste = les niveaux `:sky #f` de level-info.gc + sunkenb
;; (déclaré avec ciel mais entièrement sous l'eau/sous terre).
(define *remake-interior-levels* '(jungleb sunken sunkenb maincave darkcave robocave lavatube citadel intro demo title))
;; 1.0 = forcer intérieur, 0.0 = forcer extérieur, <0 = automatique (tests REPL)
(define *remake-interior-force* -1.0)
(defun remake-shadow-sun-factor ((elev float))
  "Force des ombres portées selon la hauteur du soleil. 22/09 (captures :
   grand pan noir à bord droit derrière Klaww, village de pierre, soleil bas) :
   avant, pleine force dès 19° (3·elev) — un soleil rasant tirait des ombres
   longues, dures et noires que les artistes n'ont jamais peintes. Montée en
   carré : 11° → 25 %, 17° → 55 %, 24° → 100 %."
  (let ((e (fmax 0.0 (fmin 1.0 (* 2.5 elev)))))
    (* e e)))

;; 12/10 RENDU REMAKE (lumière de la cabane de Samos) : les INTÉRIEURS des
;; huttes d'un niveau extérieur. Cylindres verticaux (x z rayon ymin ymax, en
;; mètres) — dedans, la caméra passe en éclairage d'intérieur : lampes allumées
;; à toute heure, plus de ciel bleu sur les murs. Fondu de 2 m au bord.
;; Hutte de Samos : axe = sphères poi du jeu (-129.2, 208.4) recentré sur les
;; murs sondés au REPL (collision : rez-de-chaussée à 14.4 m en +x, 14.6 m en -x,
;; 14.7-15.4 m vers -z ; caméra plaquée au mur à 13.7 m) → plein dedans jusqu'à
;; 14 m, nul à 16 m. Plancher 33.5 m, toit < 64 m.
(define *remake-hut-volumes*
  (new 'static 'boxed-array :type float
       -130.5 208.4 16.0 31.5 64.0))
(defun remake-hut-interior-amount ()
  "Part d'intérieur de hutte de la CAMÉRA (0..1)."
  (let ((best 0.0)
        (cam (-> *math-camera* trans))
        (n (/ (-> *remake-hut-volumes* length) 5)))
    (dotimes (i n)
      (let* ((b (* i 5))
             (dx (- (/ (-> cam x) 4096.0) (-> *remake-hut-volumes* b)))
             (dz (- (/ (-> cam z) 4096.0) (-> *remake-hut-volumes* (+ b 1))))
             (r (-> *remake-hut-volumes* (+ b 2)))
             (y (/ (-> cam y) 4096.0))
             (d (sqrtf (+ (* dx dx) (* dz dz))))
             (in-r (fmax 0.0 (fmin 1.0 (/ (- r d) 2.0))))
             (in-y (fmin (fmax 0.0 (fmin 1.0 (/ (- y (-> *remake-hut-volumes* (+ b 3))) 2.0)))
                         (fmax 0.0 (fmin 1.0 (/ (- (-> *remake-hut-volumes* (+ b 4)) y) 2.0)))))
             (v (* in-r in-y)))
        (if (< best v) (set! best v))))
    best))

(defun remake-hut-amount ()
  "Part d'intérieur de HUTTE seule (0 hors village1) — teinte chaude du post."
  (if (or (= (-> *level* level0 name) 'village1) (= (-> *level* level1 name) 'village1))
      (remake-hut-interior-amount)
      0.0))

(defun remake-interior-amount ()
  "0 = extérieur, 1 = intérieur. Suit `current-interp`, le fondu d'ambiance que le
   moteur calcule lui-même entre les deux niveaux résidents (distance aux niveaux)
   — la transition jungle ↔ temple est donc continue, sans dépendre du point de
   reprise (level-get-target-inside le préfère et se trompait d'un niveau).
   12/10 : + intérieurs de huttes (voir *remake-hut-volumes*)."
  (cond
    ((>= *remake-interior-force* 0.0) *remake-interior-force*)
    (else
     (let ((i0 (if (and (!= (-> *level* level0 status) 'inactive)
                        (nmember (-> *level* level0 name) *remake-interior-levels*))
                   1.0
                   0.0))
           (i1 (if (and (!= (-> *level* level1 status) 'inactive)
                        (nmember (-> *level* level1 name) *remake-interior-levels*))
                   1.0
                   0.0))
           (t (fmax 0.0 (fmin 1.0 (-> *time-of-day-context* current-interp)))))
       (fmax (+ (* i0 (- 1.0 t)) (* i1 t)) (remake-hut-amount))))))

(defun remake-interior? ()
  "Jak est-il (surtout) dans un niveau intérieur ?"
  (< 0.5 (remake-interior-amount)))

;; 20/10 : dose des rayons de soleil (post_processing.frag / shafts.frag) — la jungle, et
;; la cabane de Samos (camera dedans) ; de jour seulement.
(defun remake-shaft-amount ((night float))
  (let ((lev (level-get-target-inside *level*))
        (day (fmax 0.0 (- 1.0 (* 1.5 night)))))
    (cond
      ((and lev (= (-> lev name) 'jungle)) (* *remake-shafts* day))
      ;; cabane : interieur sombre, peu de soleil entre — dose x2,5 pour que les rayons qui
      ;; passent la porte et les ouvertures se lisent
      (else (* 2.5 *remake-shafts* day (remake-hut-amount))))))

;; PC-REMAKE 25/10 : humidite de Jak (definie dans water.gc, apres le type water-control)
(define-extern remake-update-wet (function int))

(defun update-time-of-day ((arg0 time-of-day-context))
  "Update the time of day context"
  ;; set defaults
  (set! (-> arg0 sky) #f)
  (set! (-> arg0 target-interp) 0.0)
  (when *target*
    (set! (-> *target* draw light-index) (the-as uint 0))
    (when (-> *target* sidekick)
      (set! (-> *target* sidekick 0 draw light-index) (the-as uint 0))
      0))
  ;; see if either level gives us a sky.
  (dotimes (v1-12 (-> *level* length))
    (let ((a0-4 (-> *level* level v1-12)))
      (when (= (-> a0-4 status) 'active)
        (if (-> a0-4 info sky) (set! (-> arg0 sky) #t)))))
  ;; level distances
  (let ((s4-0 (the-as (array float) (new 'stack 'boxed-array float 2))))
    (set! (-> s4-0 0) 0.0)
    (set! (-> s4-0 1) 0.0)
    0.0
    (let ((s5-0 0)
          (f30-0 (-> arg0 current-interp)))
      (set! *lightning-frame-done* #f)
      (set! *lightning-realtime-done* #f)
      ;; loop over levels and figure out which to use.
      (dotimes (s3-0 2)
        (let ((s2-0 (-> *level* level s3-0)))
          (cond
            ((!= (-> s2-0 status) 'inactive)
             ;; level is good, use its mood
             (set! (-> s4-0 s3-0) (-> s2-0 level-distance))
             (set! (-> arg0 moods s3-0) (-> s2-0 mood))
             ;; run its mood callback
             ((-> s2-0 mood-func) (-> s2-0 mood) (-> arg0 time) s3-0)
             ;; sky count
             (if (and (= (-> s2-0 status) 'active) (-> s2-0 info sky)) (+! s5-0 1)))
            (else
             ;; level is no good. Use the default mood in its place.
             (set! (-> s4-0 s3-0) 4095996000.0)
             (set! (-> arg0 moods s3-0) *default-mood*)
             (update-mood-default *default-mood* (-> arg0 time) 0)))))
      ;; now pick desired interpolation weights
      (let* ((f0-6 (-> s4-0 0))
             (f1-0 (-> s4-0 1))
             (f28-0 (cond
                      ((= f1-0 4095996000.0)
                       ;; second level is no good, just use first
                       0.0)
                      ((= f0-6 4095996000.0)
                       ;; first level is no good, just use second
                       1.0)
                      ((= f0-6 f1-0)
                       ;; not sure why this is special cased...
                       0.5)
                      ;; this is a hack to pick the mood of village2 when we're closer to sunken, as long as
                      ;; the camera is above 0.
                      ((and (< 0.0 (-> *math-camera* trans y)) (= (-> *level* level0 name) 'village2) (= (-> *level* level1 name) 'sunken))
                       0.0 ;; picks 0 = village2
                       )
                      ((and (< 0.0 (-> *math-camera* trans y)) (= (-> *level* level0 name) 'sunken) (= (-> *level* level1 name) 'village2))
                       1.0 ;; picks 1 = village2
                       )
                      (else
                       ;; interplate between them.
                       (/ f0-6 (+ f0-6 f1-0))))))
        ;; normally we will slowly ramp the interpolation weights.
        ;; but if we've just teleported, immediately snap to the new value.
        (if *teleport* (set! f30-0 f28-0))
        ;; ramp interpolation weights.
        (when (not (or (paused?) (= f28-0 f30-0)))
          (let ((f0-7 (- f30-0 f28-0)))
            (set! f30-0
                  (cond
                    ((= (-> *setting-control* current video-mode) 'pal)
                     (cond
                       ((< (fabs f0-7) 0.00396)
                        ;; close enough
                        f28-0)
                       ((< f0-7 0.0)
                        ;; ramp up
                        (+ 0.00396 f30-0))
                       (else
                        ;; ramp down
                        (+ -0.00396 f30-0))))
                    ((< (fabs f0-7) 0.0033)
                     ;; close enough
                     f28-0)
                    ((< f0-7 0.0)
                     ;; ramp up
                     (+ 0.0033 f30-0))
                    (else
                     ;; ramp down.
                     (+ -0.0033 f30-0))))))
        ;; number of active skys
        (set! (-> arg0 active-count) (the-as uint s5-0))
        ;; interpolation value between the two level moods.
        (set! (-> arg0 interp) f28-0))
      ;; Do the interpolation
      (set! (-> arg0 current-interp) f30-0)
      (set! *sky-drawn* #f)
      (set! *cloud-drawn* #f)
      (let ((s5-1 (-> arg0 current-fog)))
        (cond
          ((= f30-0 0.0)
           ;; special case: only use level 0
           (let ((v1-67 (-> arg0 moods 0 current-fog)))
             (set! (-> s5-1 fog-color quad) (-> v1-67 fog-color quad))
             (set! (-> s5-1 fog-dists quad) (-> v1-67 fog-dists quad))
             (set! (-> s5-1 erase-color quad) (-> v1-67 erase-color quad)))
           (set! (-> arg0 current-prt-color quad) (-> arg0 moods 0 current-prt-color quad))
           (set! (-> arg0 current-sun sun-color quad) (-> arg0 moods 0 current-sun sun-color quad))
           (set! (-> arg0 current-sun env-color quad) (-> arg0 moods 0 current-sun env-color quad))
           (set! (-> arg0 current-shadow quad) (-> arg0 moods 0 current-shadow quad))
           (set! (-> arg0 current-shadow-color quad) (-> arg0 moods 0 current-shadow-color quad))
           (dotimes (s4-1 8)
             (quad-copy! (the-as pointer (-> arg0 light-group s4-1)) (the-as pointer (-> arg0 moods 0 light-group s4-1)) 12))
           (set! (-> arg0 num-stars) (-> arg0 moods 0 num-stars))
           (set! (-> arg0 sun-fade) (-> *level* level0 info sun-fade)))
          ((= f30-0 1.0)
           ;; special case: use only level 1
           (let ((v1-88 (-> arg0 moods 1 current-fog)))
             (set! (-> s5-1 fog-color quad) (-> v1-88 fog-color quad))
             (set! (-> s5-1 fog-dists quad) (-> v1-88 fog-dists quad))
             (set! (-> s5-1 erase-color quad) (-> v1-88 erase-color quad)))
           (set! (-> arg0 current-prt-color quad) (-> arg0 moods 1 current-prt-color quad))
           (set! (-> arg0 current-sun sun-color quad) (-> arg0 moods 1 current-sun sun-color quad))
           (set! (-> arg0 current-sun env-color quad) (-> arg0 moods 1 current-sun env-color quad))
           (set! (-> arg0 current-shadow quad) (-> arg0 moods 1 current-shadow quad))
           (set! (-> arg0 current-shadow-color quad) (-> arg0 moods 1 current-shadow-color quad))
           (dotimes (s4-2 8)
             (quad-copy! (the-as pointer (-> arg0 light-group s4-2)) (the-as pointer (-> arg0 moods 1 light-group s4-2)) 12))
           (set! (-> arg0 num-stars) (-> arg0 moods 1 num-stars))
           (set! (-> arg0 sun-fade) (-> *level* level1 info sun-fade)))
          (else
           ;; interpolate!
           ;; note: the array access here seems to be different from everywhere else and I suspect there was some
           ;; weird pointer math in the original code.
           (let ((s4-3 (-> arg0 moods 0 current-fog))
                 (s3-1 (-> arg0 moods 1 current-fog)))
             (vector4-lerp! (-> s5-1 fog-color) (-> s4-3 fog-color) (-> s3-1 fog-color) f30-0)
             (vector4-lerp! (-> s5-1 fog-dists) (-> s4-3 fog-dists) (-> s3-1 fog-dists) f30-0)
             (vector4-lerp! (-> s5-1 erase-color) (-> s4-3 erase-color) (-> s3-1 erase-color) f30-0))
           (vector4-lerp! (-> arg0 current-prt-color)
                          (-> arg0 moods 0 current-prt-color)
                          (-> arg0 moods 1 current-prt-color)
                          f30-0)
           (vector4-lerp! (-> arg0 current-sun sun-color)
                          (-> arg0 moods 0 current-sun sun-color)
                          (-> arg0 moods 1 current-sun sun-color)
                          f30-0)
           (vector4-lerp! (-> arg0 current-sun env-color)
                          (-> arg0 moods 0 current-sun env-color)
                          (-> arg0 moods 1 current-sun env-color)
                          f30-0)
           (vector4-lerp! (-> arg0 current-shadow) (-> arg0 moods 0 current-shadow) (-> arg0 moods 1 current-shadow) f30-0)
           (vector4-lerp! (-> arg0 current-shadow-color)
                          (-> arg0 moods 0 current-shadow-color)
                          (-> arg0 moods 1 current-shadow-color)
                          f30-0)
           (dotimes (s4-4 8)
             (dotimes (s3-2 3)
               (let ((s2-1 (+ (+ (* 48 s3-2) 156 (* 192 s4-4)) (the-as int arg0))))
                 (let ((s1-0 (+ (+ (* 48 s3-2) 156 (* 192 s4-4)) (the-as int (-> arg0 moods 0))))
                       (s0-0 (+ (+ (* 48 s3-2) 156 (* 192 s4-4)) (the-as int (-> arg0 moods 1)))))
                   (vector4-lerp! (the-as vector (+ s2-1 0)) (the-as vector (+ s1-0 0)) (the-as vector (+ s0-0 0)) f30-0)
                   (vector4-lerp! (the-as vector (+ s2-1 16)) (the-as vector (+ s1-0 16)) (the-as vector (+ s0-0 16)) f30-0)
                   (vector4-lerp! (the-as vector (+ s2-1 32)) (the-as vector (+ s1-0 32)) (the-as vector (+ s0-0 32)) f30-0))
                 (vector-normalize! (the-as vector (+ s2-1 0)) 1.0)))
             (let ((s3-3 (+ (the-as uint (-> arg0 light-group 0 ambi)) (* 192 s4-4)))
                   (s2-2 (+ (the-as uint (-> arg0 moods 0 light-group 0 ambi)) (* 192 s4-4)))
                   (s1-1 (+ (the-as uint (-> arg0 moods 1 light-group 0 ambi)) (* 192 s4-4))))
               (vector4-lerp! (the-as vector (+ s3-3 0)) (the-as vector (+ s2-2 0)) (the-as vector (+ s1-1 0)) f30-0)
               (vector4-lerp! (the-as vector (+ s3-3 16)) (the-as vector (+ s2-2 16)) (the-as vector (+ s1-1 16)) f30-0)
               (vector4-lerp! (the-as vector (+ s3-3 32)) (the-as vector (+ s2-2 32)) (the-as vector (+ s1-1 32)) f30-0)))
           (set! (-> arg0 num-stars)
                 (+ (-> arg0 moods 0 num-stars) (* (- (-> arg0 moods 1 num-stars) (-> arg0 moods 0 num-stars)) f30-0)))
           (let ((f0-20 (-> *level* level0 info sun-fade)))
             (set! (-> arg0 sun-fade) (+ f0-20 (* f30-0 (- (-> *level* level1 info sun-fade) f0-20)))))))
        ;; setup sky stuff
        (dotimes (s4-5 2)
          (make-sky-textures arg0 s4-5))
        (set! (-> sky-base-polygons 0 col quad) (-> s5-1 erase-color quad))
        (set! (-> sky-base-polygons 1 col quad) (-> s5-1 erase-color quad))
        (set! (-> sky-base-polygons 2 col quad) (-> s5-1 erase-color quad))
        (set! (-> sky-base-polygons 3 col quad) (-> s5-1 erase-color quad))
        (set! (-> sky-base-polygons 4 col quad) (-> s5-1 erase-color quad))
        (set! (-> sky-base-polygons 5 col quad) (-> s5-1 erase-color quad))
        (set! (-> sky-base-polygons 6 col quad) (-> s5-1 erase-color quad))
        (set! (-> sky-base-polygons 7 col quad) (-> s5-1 erase-color quad))
        (set! (-> sky-base-polygons 8 col quad) (-> s5-1 erase-color quad))
        (set! (-> sky-base-polygons 9 col quad) (-> s5-1 erase-color quad))
        (set! (-> sky-base-polygons 10 col quad) (-> s5-1 erase-color quad))
        (set! (-> sky-base-polygons 11 col quad) (-> s5-1 erase-color quad)))))
  (set! (-> arg0 current-sun env-color x) (* 0.5019608 (-> arg0 current-sun env-color x)))
  (set! (-> arg0 current-sun env-color y) (* 0.5019608 (-> arg0 current-sun env-color y)))
  (set! (-> arg0 current-sun env-color z) (* 0.5019608 (-> arg0 current-sun env-color z)))
  (set! (-> arg0 current-sun env-color w) (* 0.5019608 (-> arg0 current-sun env-color w)))
  (let ((v1-179 (-> arg0 current-fog)))
    (set! *fog-color*
          (new 'static
               'rgba
               :r
               (the int (-> v1-179 fog-color x))
               :g
               (the int (-> v1-179 fog-color y))
               :b
               (the int (-> v1-179 fog-color z)))))
  (let ((v1-184 (-> arg0 current-fog erase-color)))
    (set! (-> arg0 erase-color)
          (new 'static 'rgba :a #x80 :b (the int (-> v1-184 z)) :g (the int (-> v1-184 y)) :r (the int (-> v1-184 x)))))
  (set! (-> *math-camera* fog-start) (-> arg0 current-fog fog-dists x))
  (set! (-> *math-camera* fog-end) (-> arg0 current-fog fog-dists y))
  (set! (-> *math-camera* fog-max) (-> arg0 current-fog fog-dists z))
  (set! (-> *math-camera* fog-min) (-> arg0 current-fog fog-dists w))
  ;; interp target lights. (note: added check here.)
  (let* ((v1-195 (if *target* (-> *target* draw light-index) 0))
         (f30-1 (-> arg0 target-interp))
         (s4-6 (-> arg0 light-group))
         (s5-2 (-> arg0 light-group v1-195)))
    (when (nonzero? v1-195)
      (cond
        ((= f30-1 1.0))
        ((= f30-1 0.0) (quad-copy! (the-as pointer (-> arg0 light-group v1-195)) (the-as pointer (-> arg0 light-group)) 12))
        (else
         (dotimes (s3-4 4)
           (vector4-lerp! (the-as vector (+ (the-as uint (-> s5-2 dir0)) (* 48 s3-4)))
                          (the-as vector (+ (the-as uint (-> s4-6 0)) (* 48 s3-4)))
                          (the-as vector (+ (the-as uint (-> s5-2 dir0)) (* 48 s3-4)))
                          f30-1)
           (vector4-lerp! (the-as vector (+ (the-as uint (-> s5-2 dir0 color)) (* 48 s3-4)))
                          (the-as vector (+ (the-as uint (-> s4-6 0 dir0 color)) (* 48 s3-4)))
                          (the-as vector (+ (the-as uint (-> s5-2 dir0 color)) (* 48 s3-4)))
                          f30-1)
           (vector4-lerp! (the-as vector (+ (the-as uint (-> s5-2 dir0 levels)) (* 48 s3-4)))
                          (the-as vector (+ (the-as uint (-> s4-6 0 dir0 levels)) (* 48 s3-4)))
                          (the-as vector (+ (the-as uint (-> s5-2 dir0 levels)) (* 48 s3-4)))
                          f30-1)
           (vector-normalize! (the-as vector (+ (the-as uint (-> s5-2 dir0)) (* 48 s3-4))) 1.0))))
      ;; some shadow thing.
      (let ((a2-30 (new 'stack-no-clear 'vector)))
        (set! (-> a2-30 x) (- (-> s5-2 dir0 direction x)))
        (set! (-> a2-30 y) (- (-> s5-2 dir0 direction y)))
        (set! (-> a2-30 z) (- (-> s5-2 dir0 direction z)))
        (when (< (-> s5-2 dir0 direction y) 0.9063)
          (let ((f0-57 (/ 0.4226 (sqrtf (+ (square (-> a2-30 x)) (square (-> a2-30 z)))))))
            (set! (-> a2-30 x) (* (-> a2-30 x) f0-57))
            (set! (-> a2-30 y) -0.9063)
            (set! (-> a2-30 z) (* (-> a2-30 z) f0-57))))
        (vector4-lerp! (-> arg0 current-shadow) (-> arg0 current-shadow) a2-30 f30-1))
      (vector-normalize! (-> arg0 current-shadow) 1.0)))
  ;; PC-REMAKE : post-traitement des groupes de lumière finaux (voir défs plus haut).
  (when (!= *remake-sun-boost* 1.0)
    (dotimes (i 9)
      (let ((grp (-> arg0 light-group i)))
        (set! (-> grp dir0 levels x) (* *remake-sun-boost* (-> grp dir0 levels x)))
        (set! (-> grp ambi levels x) (* *remake-ambi-mult* (-> grp ambi levels x))))))
  ;; PC-REMAKE : herbe réactive — position de Jak + intensité (0.35 immobile,
  ;; jusqu'à 1.0 en course) transmises chaque frame au renderer shrub.
  ;; 20/10 : CINEMATIQUES (pile d'energie, scenes jouees par Jak) : l'herbe autour de Jak se
  ;; couche (shrub.vert) — fondu ~0,2 s a l'entree, ~0,6 s au retour.
  (let ((cine (and *target* (or (= (-> *target* next-state name) 'target-clone-anim) (movie?)))))
    (set! *remake-grass-clear*
          (if cine
              (fmin 1.0 (+ *remake-grass-clear* (* 0.08 (-> *display* time-adjust-ratio))))
              (fmax 0.0 (- *remake-grass-clear* (* 0.03 (-> *display* time-adjust-ratio))))))
    (if *target*
        (pc-set-grass-clear! (-> *target* control trans x)
                             (-> *target* control trans y)
                             (-> *target* control trans z)
                             *remake-grass-clear*)
        (pc-set-grass-clear! 0.0 0.0 0.0 0.0)))
  ;; 20/10 : TRACES DANS LA NEIGE — Jak au sol sur de la neige (0.5) ou de la neige profonde
  ;; (1.0) : le rendu creuse un sillon sous ses pieds (background_common.cpp, post)
  ;; (v1 : position 0 0 0 envoyee en l'air — le rendu croyait Jak a l'origine et la trace
  ;; disparaissait pendant chaque saut ; la position est desormais toujours transmise)
  (if *target*
      (let ((mat (-> *target* control ground-pat material)))
        (pc-set-snow-step! (-> *target* control trans x)
                           (-> *target* control trans y)
                           (-> *target* control trans z)
                           (cond
                             ((or (not (logtest? (-> *target* control status) (cshape-moving-flags onsurf)))
                                  (movie?))
                              0.0)
                             ((= mat (pat-material deepsnow)) 1.0)
                             ((= mat (pat-material snow)) 0.5)
                             ;; 25/10 : sable -> empreintes de pied (background_common.cpp)
                             ((= mat (pat-material sand)) 0.25)
                             (else 0.0))))
      (pc-set-snow-step! 0.0 0.0 0.0 0.0))
  (if *target*
      (pc-set-grass-push! (-> *target* control trans x)
                          (-> *target* control trans y)
                          (-> *target* control trans z)
                          (fmin 1.0 (+ 0.35 (/ (vector-length (-> *target* control transv)) 49152.0))))
      (pc-set-grass-push! 0.0 0.0 0.0 0.0))
  ;; PC-REMAKE : post-effets écran (bloom / saturation / chaleur).
  (pc-set-post-fx! (* 0.01 (-> *remake-gfx* bloom)) *remake-bloom-thresh* *remake-saturation* *remake-warmth*)
  ;; PC-REMAKE : cel-shading (doux par défaut, réglable au REPL). Le 4e champ
  ;; (libre) porte cinématique en cours : pendant un film, le shader
  ;; aplatit TOUT le modelé directionnel reconstruit (normales géométriques =
  ;; facettes sur les visages en gros plan) — les personnages retrouvent
  ;; l'éclairage lisse par sommet des artistes, à toute distance (25/08).
  (pc-set-toon-fx! *remake-toon-poster* *remake-toon-edge* *remake-toon-levels* (if (movie?) 1.0 0.0))
  ;; PC-REMAKE : post par profondeur (SSAO / brume / DOF / tonemap).
  ;; 12/10 : dans une hutte, occlusion ×1.3 (coins, poutres : la profondeur d'une
  ;; pièce éclairée aux lampions)
  (pc-set-depth-fx! (* 0.01 (-> *remake-gfx* occlusion) (+ 1.0 (* 0.3 (remake-hut-amount))))
                    *remake-depth-fog* *remake-dof* *remake-tonemap*)
  ;; PC-REMAKE : lumière refaite. L'ambiance hémisphérique prend sa teinte du
  ;; CIEL DU NIVEAU À CETTE HEURE (couleur du soleil courant), et le rebond au
  ;; sol reste chaud — c'est ce qui fait qu'une ombre est bleutée en plein jour
  ;; et dorée au couchant, au lieu d'être un simple assombrissement.
  ;; 22/09 : qualité des effets + gain des lens flares (4e paramètre)
  (pc-set-fx-quality! 2 1 1 *remake-lens-flare*)
  ;; 12/10 : étalonnage rendu remake (dose = curseur du menu Remake)
  ;; 12/10 : HUTTE (part 0..1) — réglé sur la hutte de Samos contre l'image de
  ;; référence : exposition 0.95, contraste 1.6, saturation 1.15, vignette 0.8
  ;; (l'étalonnage extérieur, fait pour un village cramé à 61 %, écrasait ses
  ;; hautes lumières : p95 0.82 → 0.64)
  (let ((hut (remake-hut-amount)))
    (pc-set-grade! (* 0.01 (-> *remake-gfx* grade))
                   *remake-grade-sharp*
                   (lerp *remake-grade-vignette* 0.8 hut)
                   *remake-grade-tint*)
    ;; 4e paramètre : part de hutte → rebond chaud, lampions allumés, flaques serrées
    ;; 26/10 : l'etalonnage de la cabane est fait PAR PIXEL dans le post (post_processing.frag,
    ;; pc_hut_inside, valeurs 0.95 / 1.6 / 1.15) : le dehors vu par l'ouverture garde celui de
    ;; l'exterieur. On envoie donc l'exterieur, et la part de cabane en 4e.
    ;; (original : (pc-set-grade2! (lerp *remake-grade-exposure* 0.95 hut)
    ;;                             (lerp *remake-grade-contrast* 1.6 hut)
    ;;                             (lerp *remake-grade-saturation* 1.15 hut)
    ;;                             hut))
    (pc-set-grade2! *remake-grade-exposure*
                    *remake-grade-contrast*
                    *remake-grade-saturation*
                    hut))
  (pc-set-light-fx! (* 0.01 (-> *remake-gfx* godrays))
                    (* 0.01 (-> *remake-gfx* sun))
                    *remake-hemi-ambient*
                    *remake-light-spec*)
  (let ((sun (-> arg0 current-sun sun-color))
        (interior (remake-interior-amount)))
    (pc-set-sky-ambient! (fmax 0.35 (fmin 1.3 (+ 0.45 (* 0.55 (-> sun x)))))
                         (fmax 0.40 (fmin 1.3 (+ 0.55 (* 0.55 (-> sun y)))))
                         (fmax 0.55 (fmin 1.4 (+ 0.75 (* 0.50 (-> sun z)))))
                         0.46)
    ;; 21/09 : 3e paramètre = part d'intérieur 0..1 (ground_color.w dans le post),
    ;; 4e = gain du détail des sols (tfrag3.frag)
    (pc-set-ground-ambient! 0.39 0.30 interior (* 0.01 (-> *remake-gfx* detail))))
  ;; PC-REMAKE : direction du soleil selon l'heure (angle est→ouest, nuit = off).
  ;; sin/cos GOAL travaillent en unités de rotation : 32768 = demi-tour, donc
  ;; 6 h → 0, 12 h → 16384 (zénith), 18 h → 32768.
  (let* ((hour (-> arg0 time))
         (angle (* 2730.6667 (- hour 6.0)))
         (elev (sin angle))
         ;; 21/09 : le soleil VISIBLE du ciel (sky-make-sun-data, orbite du niveau :
         ;; village1 lève en +z, couche en -z — en accord avec les tables mood-lights
         ;; des artistes). Le soleil synthétique ci-dessous voyageait le long de x :
         ;; 84° d'écart mesurés à 9 h → ombres et relumière à contre-sens des faces
         ;; peintes, deux ombres par personnage, deux soleils. |pos| = 0 quand le
         ;; niveau n'a pas de soleil (grottes) → on garde alors l'ancien chemin.
         (sun-pos (-> *sky-parms* upload-data sun 0 pos))
         (sun-len (vector-length sun-pos))
         (sun-vis (and (-> *remake-gfx* sun-visible) *remake-sun-from-mood* (< 4096.0 sun-len)))
         (interior (remake-interior-amount))
         (exterior (- 1.0 interior)))
    (when sun-vis
      ;; l'élévation suit le vrai soleil : la nuit tombe quand il se couche à l'écran
      (set! elev (/ (-> sun-pos y) sun-len)))
    ;; 21/09 : intérieur = pas d'ombres portées du soleil (la carte d'ombres
    ;; d'une grotte = tout le niveau à l'ombre de son propre plafond) — fondu
    ;; continu avec la part d'intérieur
    ;; 20/10 : dans la cabane (exterieur ~0), le vrai soleil reste transmis, a force 0 — la
    ;; carte d'ombres ne sert alors qu'aux rayons (pas d'ombres portees a l'interieur)
    ;; (original : (if (and (< 0.05 elev) (< 0.02 exterior))
    (if (and (< 0.05 elev) (or (< 0.02 exterior) (< 0.001 (remake-shaft-amount 0.0))))
        (cond
          (sun-vis
            (pc-set-sun-shadow! (- (/ (-> sun-pos x) sun-len))
                                (- (/ (-> sun-pos y) sun-len))
                                (- (/ (-> sun-pos z) sun-len))
                                (* exterior 0.01 (-> *remake-gfx* shadows) (remake-shadow-sun-factor elev))))
          (else
            ;; (original) le soleil voyage vers -y ; x = composante est-ouest, léger biais z
            (pc-set-sun-shadow! (cos angle) (- elev) 0.25 (* exterior 0.01
                                                            (-> *remake-gfx* shadows)
                                                            (remake-shadow-sun-factor elev)))))
        (pc-set-sun-shadow! 0.3 0.85 0.25 0.0))
    ;; PC-REMAKE : la nuit suit la hauteur du soleil, pas un interrupteur —
    ;; le crépuscule s'installe pendant que le soleil passe sous l'horizon.
    (let ((night (cond
                   ((>= *remake-night-force* 0.0) *remake-night-force*)
                   (else
                    ;; 21/09 : intérieur = jamais de clair de lune (l'éclairage
                    ;; des artistes reste tel quel) — fondu continu avec la part
                    ;; d'intérieur ; niveaux sans lampes : plafond plus bas
                    (let ((lev (level-get-target-inside *level*)))
                      (* exterior
                         (fmin (if (and lev (nmember (-> lev name) *remake-nolamp-levels*))
                                   *remake-night-max-nolamp*
                                   *remake-night-max*)
                               (fmax 0.0 (fmin 1.0 (* 2.2 (- 0.10 elev)))))))))))
      (pc-set-night-fx! (* night 0.01 (-> *remake-gfx* night))
                        (* 0.01 (-> *remake-gfx* lamp-range))
                        ;; lampes : pleine puissance en intérieur, sinon avec la nuit
                        (* (fmax night interior) 0.01 (-> *remake-gfx* lamp-power))
                        ;; 20/10 : 4e parametre = dose des rayons de soleil (jungle)
                        (remake-shaft-amount night))
      ;; 27/10 : lucioles la nuit — dans la jungle (foret) et au village (autour des lampes)
      (let ((lev (level-get-target-inside *level*)))
        (pc-set-vie-zone! (cond
                            ((not lev) 0)
                            ((= (-> lev name) 'jungle) 2)
                            ((= (-> lev name) 'village1) 1)
                            (else 0))))
      (set! *remake-night-now* night)))
  ;; PC-REMAKE 19/08 : l'eco PORTE rayonne — Jak charge d'eco bleu eclaire
  ;; bleu autour de lui en courant, rouge en rouge, jaune en jaune. L'intensite
  ;; suit la reserve restante (eco-level) : la lueur s'eteint avec l'eco.
  ;; PC-REMAKE 25/10 : JAK MOUILLE (merc2.frag) — en nageant, tout le corps ; en pataugeant, les
  ;; jambes jusqu'a la surface ; hors de l'eau, il seche (le haut en ~15 s, les jambes en ~25 s)
  (remake-update-wet)
  (when (and *target* (> (-> *target* fact eco-level) 0.0))
    (let ((kind (cond
                  ((= (-> *target* fact eco-type) (pickup-type eco-blue)) 2)
                  ((= (-> *target* fact eco-type) (pickup-type eco-red)) 6)
                  ((= (-> *target* fact eco-type) (pickup-type eco-yellow)) 5)
                  (else 1))))
      ;; fondu de fin : la lueur s'eteint en douceur sur les ~3 dernieres
      ;; secondes de l'eco (300 ticks/s), pas d'un coup a l'expiration
      (let* ((ecoule (the float (- (-> *display* game-frame-counter) (-> *target* fact eco-pickup-time))))
             (restant (- (the float (-> *target* fact eco-timeout)) ecoule))
             (fondu (fmax 0.0 (fmin 1.0 (/ restant 900.0)))))
        ;; 25/10 : l'eco BLEU porte eclaire plus doucement (x0.55) : Jak, au coeur de la source,
        ;; virait entierement au bleu et la jungle sombre au violet
        ;; (original : (* fondu (fmin 2.5 (* 2.0 (-> *target* fact eco-level)))))
        (pc-add-lamp! (-> *target* control trans x)
                      (+ 6144.0 (-> *target* control trans y))
                      (-> *target* control trans z)
                      45056.0
                      (* fondu
                         (if (= kind 2) 0.55 1.0)
                         (fmin 2.5 (* 2.0 (-> *target* fact eco-level))))
                      kind))))
  (when (and (> *remake-lamp-debug* 0.0) *target*)
    (pc-add-lamp! (-> *target* control trans x)
                  (+ 20480.0 (-> *target* control trans y))
                  (-> *target* control trans z)
                  (* 49152.0 *remake-lamp-debug*)
                  2.0
                  (the int *remake-lamp-debug-kind*)))
  ;; 17/10 : intro Naughty Dog → post neutre (voir remake-intro-active?)
  (when (remake-intro-active?)
    (pc-set-post-fx! 0.0 0.0 0.0 0.0)
    (pc-set-depth-fx! 0.0 0.0 0.0 0.0)
    (pc-set-grade! 0.0 0.0 0.0 0.0)
    (pc-set-light-fx! 0.0 0.0 0.0 0.0)
    (pc-set-night-fx! 0.0 0.0 0.0 0.0)
    (pc-set-sun-shadow! 0.3 0.85 0.25 0.0))
  (reset! *palette-fade-controls*)
  0
  (none))

(defmethod set-fade! ((this palette-fade-controls) (arg0 int) (arg1 float) (arg2 float) (arg3 vector))
  (cond
    ((and (>= arg0 0) (< arg0 8))
     (let ((v1-3 (-> this control arg0)))
       (when (< arg2 (-> v1-3 actor-dist))
         (if arg3 (set! (-> v1-3 trans quad) (-> arg3 quad)))
         (set! (-> v1-3 fade) (fmax 0.0 (fmin 1.993 arg1)))
         (set! (-> v1-3 actor-dist) arg2))))
    (else (format 0 "ERROR: Bogus palette-fade-control index!~%"))))

(defmethod reset! ((this palette-fade-controls))
  (countdown (v1-0 8)
    (let ((a1-2 (-> this control v1-0))) (set! (-> a1-2 fade) 0.0) (set! (-> a1-2 actor-dist) 4096000000.0)))
  #f)

;; start the time of day process!!
(start-time-of-day)
