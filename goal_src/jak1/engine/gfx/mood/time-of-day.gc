;; les réglages que le joueur peut bouger depuis le menu du jeu
(deftype remake-gfx (structure)
  ((night      float)
   (lamp-power float)
   (lamp-range float)
   (sun        float)
   (occlusion  float)
   (shadows    float)
   (godrays    float)
   (bloom      float)
   ;; #t = direction du soleil visible du ciel (= tables des artistes)
   (sun-visible symbol)
   ;; détail intrinsèque des sols (grain + accentuation, tfrag3.frag), en %
   (detail     float)
   ;; dose de l'étalonnage rendu remake, en %
   (grade      float)))

(define *remake-gfx*
  (new 'static 'remake-gfx
       :sun-visible #t
       :detail 140.0
       :grade 100.0
       :night 100.0
       :lamp-power 200.0
       :lamp-range 260.0
       :sun 75.0
       :occlusion 55.0
       :shadows 60.0
       :godrays 70.0
       :bloom 55.0))
(define *remake-lamp-reach* 1.8)
(define *remake-lamp-bright* 1.3)
(define *remake-night-force* -1.0)
;; >0 : pose une lampe témoin sur Jak, pour vérifier la reconstruction monde
(define *remake-lamp-debug* 0.0)
(define *remake-lamp-debug-kind* 0)
;; valeur courante (0..1), lue par les lampes pour ne s'allumer qu'au crépuscule
(define *remake-night-now* 0.0)
;; rayons de soleil volumetriques a travers le feuillage (post_processing.frag)
(define *remake-shafts* 1.0)
;; dose (0..1) de l'herbe couchee autour de Jak pendant les cinematiques
(define *remake-grass-clear* 0.0)
;; INTRO NAUGHTY DOG
(define *remake-intro-frame* (the-as time-frame 0))
